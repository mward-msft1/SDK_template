# Copy this file to .env. Replace every value enclosed in angle brackets.
TENANT_ID=<YOUR_ENTRA_TENANT_ID>
BLUEPRINT_APP_ID=<YOUR_AGENT_ID_BLUEPRINT_APP_ID>
AGENT_CLIENT_ID=<YOUR_CHILD_AGENT_ID_CLIENT_ID>
AGENT_NAME=<YOUR_CLAWPILOT_AGENT_NAME>
AGENT_DESCRIPTION=<YOUR_CLAWPILOT_AGENT_DESCRIPTION>

# The user whose Purview policy should be evaluated in this beginner sample.
# Use a UPN or object ID accepted by Microsoft Graph.
PURVIEW_USER_ID=<YOUR_USER_UPN_OR_OBJECT_ID>
PURVIEW_APP_LOCATION_ID=<YOUR_PURVIEW_APPLICATION_LOCATION_ID>
PURVIEW_GRAPH_BASE_URL=https://graph.microsoft.com/beta

# These names must match the services in template/entra-sidecar/docker-compose.yml.
ENTRA_SIDECAR_URL=http://localhost:5000
ENTRA_GRAPH_SERVICE_NAME=Graph
ENTRA_AGENT365_SERVICE_NAME=Agent365

# Recommended: true. A Purview or sidecar error then blocks the operation.
PURVIEW_BLOCK_ON_ERROR=true

# Keep false in normal use. It is useful only while learning locally.
ENABLE_CONSOLE_TELEMETRY=false
