# Copy to .env after running the Agent 365 CLI.
# scripts/import-blueprint.mjs fills the non-secret blueprint values.
TENANT_ID=<FROM_A365_GENERATED_CONFIG>
AGENT_BLUEPRINT_ID=<FROM_A365_GENERATED_CONFIG>
AGENT_BLUEPRINT_CLIENT_SECRET=<PASTE_FOR_LOCAL_DEVELOPMENT_ONLY>

# For local blueprint-only validation this can match AGENT_BLUEPRINT_ID.
# In production, replace it with the child/instance Agent Identity client ID.
AGENT_CLIENT_ID=<YOUR_RUNTIME_AGENT_ID>
AGENT_NAME=<YOUR_AGENT_NAME>
AGENT_DESCRIPTION=<YOUR_AGENT_DESCRIPTION>
AGENT_PROVIDER_NAME=<YOUR_AGENT_HOST_OR_FRAMEWORK>
AGENT_MODEL=<YOUR_MODEL_NAME>

# Microsoft 365 Agents SDK connection names expected by current samples.
USE_AGENTIC_AUTH=true
connections__service_connection__settings__clientId=<FROM_A365_GENERATED_CONFIG>
connections__service_connection__settings__clientSecret=<PASTE_FOR_LOCAL_DEVELOPMENT_ONLY>
connections__service_connection__settings__tenantId=<FROM_A365_GENERATED_CONFIG>

# Agent 365 observability.
A365_EXPORT_ENABLED=false
A365_CONSOLE_EXPORT_ENABLED=true
A365_RECORD_CONTENT=false
ENTRA_SIDECAR_URL=http://localhost:5000
ENTRA_AGENT365_SERVICE_NAME=Agent365
