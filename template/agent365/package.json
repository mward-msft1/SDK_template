{
  "name": "agent365-cli-sdk-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "blueprint:import": "node scripts/import-blueprint.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --import @microsoft/opentelemetry/loader dist/src/example-agent.js",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@microsoft/opentelemetry": "^1.3.0",
    "@opentelemetry/resources": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
