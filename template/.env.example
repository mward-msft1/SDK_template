# ===== Identity / Tenant =====
TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=REPLACE_WITH_SECRET

# Signed-in user context source from your host app/session
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
DEFAULT_USER_UPN=user@contoso.com

# ===== Agent runtime =====
AGENT_NAME=ContosoAgnosticAgent
AGENT_RUNTIME=agent-framework
AGENT_ENVIRONMENT=dev
HOST_SDK=agent-framework
# HOST_SDK values:
# - agent-framework
# - m365-agents-sdk
# - bedrock

# ===== Amazon Bedrock =====
# AWS credentials use the standard AWS SDK credential chain. Do not put access keys here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.2
BEDROCK_SYSTEM_PROMPT=You are a helpful enterprise assistant.
BEDROCK_PROMPT=Explain how this governed agent template works.

# ===== Microsoft 365 Agents SDK placeholders (microsoft/agents) =====
M365_AGENTS_BOT_APP_ID=00000000-0000-0000-0000-000000000000
M365_AGENTS_BOT_APP_PASSWORD=REPLACE_WITH_SECRET
M365_AGENTS_TENANT_ID=00000000-0000-0000-0000-000000000000

# ===== Agent365 placeholders =====
# Replace these with values required by your Agent365 deployment/runtime.
AGENT365_APP_ID=00000000-0000-0000-0000-000000000000
AGENT365_APP_SECRET=REPLACE_WITH_AGENT365_SECRET
AGENT365_TENANT_ID=00000000-0000-0000-0000-000000000000
AGENT365_REPORTING_ENDPOINT=https://REPLACE_WITH_AGENT365_ENDPOINT

# ===== Purview / Graph =====
PURVIEW_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PURVIEW_GRAPH_SCOPE=https://graph.microsoft.com/.default

# This must match the Entra app registration ID targeted by your Purview DLP policy
PURVIEW_APP_LOCATION_ID=00000000-0000-0000-0000-000000000000
PURVIEW_ACTIVITY_TYPES=uploadText,downloadText
PURVIEW_ENABLE_AUDIT_WHEN_NO_SCOPE=true
PURVIEW_BLOCK_ON_ERROR=true
GRAPH_ACCESS_TOKEN_PLACEHOLDER=REPLACE_WITH_SHORT_LIVED_GRAPH_TOKEN
