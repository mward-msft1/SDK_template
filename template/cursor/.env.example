# Cursor SDK (create at https://cursor.com/dashboard)
CURSOR_API_KEY=REPLACE_WITH_CURSOR_API_KEY
CURSOR_MODEL=composer-2.5
CURSOR_WORKSPACE=../..
CURSOR_PROMPT=Explain the authentication flow in this repository.
CURSOR_ISOLATE_WORKSPACE=true

# Microsoft Entra Agent ID - use the child Agent Identity client ID, not the Blueprint ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AGENT_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_BLUEPRINT_APP_ID=00000000-0000-0000-0000-000000000000
ENTRA_SIDECAR_URL=http://localhost:5000
ENTRA_SIDECAR_GRAPH_SERVICE=Graph
ENTRA_SIDECAR_A365_SERVICE=Agent365

# Purview. USER_ID is the Entra object ID of the user whose policy is evaluated.
PURVIEW_USER_ID=00000000-0000-0000-0000-000000000000
PURVIEW_APP_LOCATION_ID=00000000-0000-0000-0000-000000000000
PURVIEW_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PURVIEW_BLOCK_ON_ERROR=true

# Agent 365 observability
AGENT_NAME=Governed Cursor Agent
AGENT_DESCRIPTION=Local Cursor SDK agent protected by Microsoft Purview
ENABLE_A365_OBSERVABILITY_EXPORTER=false
ENABLE_CONSOLE_TELEMETRY=true
A365_OBSERVABILITY_LOG_LEVEL=warn
